<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Matches the Compose window colour so launch and recents never flash. -->
    <style name="Theme.DropFlow" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#F2F2F5</item>
        <item name="android:statusBarColor">#F2F2F5</item>
        <item name="android:navigationBarColor">#F2F2F5</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>
</resources>
