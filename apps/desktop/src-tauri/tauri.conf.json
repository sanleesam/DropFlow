{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DropFlow",
  "version": "0.1.2-beta.21",
  "identifier": "com.dropflow.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "DropFlow",
        "width": 1280,
        "height": 820,
        "minWidth": 1100,
        "minHeight": 720,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-src 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 ws://127.0.0.1:1420; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "macOS": {
      "signingIdentity": "-"
    },
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "resources": {
      "../../../LICENSE": "licenses/LICENSE",
      "../../../NOTICE": "licenses/NOTICE",
      "../../../THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI5RDYxNzBDNDZDMkUxMkQKUldRdDRjSkdEQmZXS1NCTzJpWHlhRGpMWVRrWExkNk5QOHVsUmIvU1cxY0Z1eFlHS3lTRXNuVEgK",
      "endpoints": [
        "https://github.com/sanleesam/DropFlow/releases/download/beta/latest.json",
        "https://github.com/sanleesam/DropFlow/releases/latest/download/latest.json"
      ]
    }
  }
}
