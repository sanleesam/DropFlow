{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DropFlow",
  "version": "0.1.0-beta.15",
  "identifier": "com.dropflow.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DropFlow",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI5RDYxNzBDNDZDMkUxMkQKUldRdDRjSkdEQmZXS1NCTzJpWHlhRGpMWVRrWExkNk5QOHVsUmIvU1cxY0Z1eFlHS3lTRXNuVEgK",
      "endpoints": [
        "https://github.com/sanleesam/DropFlow/releases/download/beta/latest.json",
        "https://github.com/sanleesam/DropFlow/releases/latest/download/latest.json"
      ]
    }
  }
}